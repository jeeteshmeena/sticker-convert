# ===== Sticker Convert Telegram Bot =====
# Copy this file to .env and fill in the values:  cp .env.example .env

# Required: token from @BotFather
BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# Your Telegram user id(s), comma separated (get it from @userinfobot). Admins can use /stats and /broadcast
ADMIN_IDS=123456789

# Leave empty for a public bot. Fill with user ids to make it private.
ALLOWED_USER_IDS=

# Shown as pack author. Empty = user's @username
DEFAULT_AUTHOR=

# Emoji given to every sticker when uploading to Telegram/Signal
DEFAULT_EMOJI=😀

# Performance (conversion is CPU heavy). Rough guide: 1 job per 2 CPU cores
MAX_CONCURRENT_JOBS=2
PROCESSES_PER_JOB=2
JOB_TIMEOUT_SECONDS=1800
MAX_FILES_PER_JOB=120

# Where temporary job files and stats live
WORK_DIR=./bot_data

# Optional: channel/group id where the bot logs finished jobs (bot must be admin there)
LOG_CHANNEL_ID=

# Optional: Signal account to upload packs directly to Signal instead of sending a zip.
# Generate with:  python -m sticker_convert --signal-get-auth   (needs Signal Desktop)
SIGNAL_UUID=
SIGNAL_PASSWORD=
